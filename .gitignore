# Environment variables / secrets
.env
.env.*
!.env.example
API_keys.*

# Python
.venv/
__pycache__/
*.pyc

# Models (too large for git)
models/

# Data (sensitive + large)
data/

# MIMIC-derived training data (contains raw note text, ~9GB)
src/reranker/reranker_training_data/

# MIMIC-derived exports and run artifacts.
# Glob, not exact names: these files embed raw note text and real subject_ids,
# so a new variant (pooled_v2.json, sweep_run3.json) must never slip through
# just because it was not listed here by name.
*.xlsx
*.csv
disease_flow/
pooled*.json
# tune_retrieval.py phase-1 output carries chunk_text (raw note text)
tune_*.json
sweep*.json
*_answers.json
indexing_log.txt

# Smoke-run eval output — a 3-query subset. results.json (the full 28-query run)
# is the committed one; keeping both invites citing the wrong table.
results_smoke.json

# Eval outputs containing raw note excerpts
evals/retrieval_results.json
mimic_profile_report.json

# Caches
.cache/
.overlap_cache/
.deepeval/

# Personal / reference material (not code)
docs/
Lumen.pdf
Smit_Shah_Resume.docx
Each phase outputs.pages
*.png

# Local tool settings
.claude/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docker
langfuse/
# Working audit doc — local only, contradicts README until rewritten
LUMEN_STATUS.md

backups/
*.dump

# Final answer-level evaluation runs. Artifacts are immutable run directories
# kept outside version control, like the cloud results in ~/Lumen_cloud_results.
# evidence_cache.jsonl inside a run holds the exact evidence text the judge
# graded against and is the only file there carrying note text.
results/final_eval/
.cache/final_eval_judge.json
