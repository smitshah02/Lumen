# Lumen — example environment. Copy to .env and fill in. No real secrets here.
# Values shown are safe local examples or code defaults; research Compose marks
# its volume and password variables as required.

# --- Postgres + pgvector ---------------------------------------------------
# Default matches docker-compose.yml (host port 5434). Set your own password.
DATABASE_URL=postgresql://postgres:lumen-local-dev@localhost:5434/lumen
# docker-compose.yml only: host port and the (external) data volume name.
# On a new machine: docker volume create lumen_pgdata. Existing installations
# must set the exact existing volume name; there is intentionally no fallback.
LUMEN_PG_PASSWORD=lumen-local-dev
LUMEN_PG_PORT=5434
LUMEN_PG_VOLUME=lumen_pgdata

# --- Local LLM (Ollama) ----------------------------------------------------
# Explicit deployment selection. Canonical fallback tags live in
# configs/models.json; tests keep these example values synchronized. Two tiers,
# picked per job by src/llm/local_client.ROLES — application code
# never names a model. MAIN runs complex/longitudinal synthesis only; FAST runs
# classification fallback, concept extraction, simple synthesis and batched
# verification. Point both at the same tag to disable the split.
LUMEN_LLM_HOST=http://localhost:11434
LUMEN_LLM_MAIN=qwen3:30b-a3b-instruct-2507-q4_K_M
LUMEN_LLM_FAST=qwen3:4b-instruct-2507-q4_K_M
LUMEN_LLM_KEEPALIVE=10m
# Load both tiers at API startup instead of inside the first request. Leave 0
# on a laptop; the Pod bootstrap sets 1.
LUMEN_LLM_WARMUP=0
# Answer "most recent <analyte>" straight from labevents with no model call.
# Set 0 to force every question through retrieval + synthesis (A/B latency runs).
LUMEN_DETERMINISTIC_LABS=1

# Independent local evaluation judge. Must differ from both runtime tiers.
LUMEN_JUDGE_MODEL=qwen2.5:14b
LUMEN_JUDGE_HOST=http://localhost:11434
# LUMEN_JUDGE_NUM_CTX=12288
# LUMEN_JUDGE_MAX_TOKENS=1600
# LUMEN_JUDGE_CACHE=.cache/final_eval_judge.json

# --- Model weights ---------------------------------------------------------
# Repository-relative roots; every value remains overrideable for containers or
# external restricted storage. Unset paths resolve from this repository root.
# LUMEN_DATA_DIR=/path/to/Lumen/data
# Directory holding medcpt-query/, medcpt-article/, medcpt-cross-encoder/,
# bge-reranker/. Unset -> <repo>/models.
# LUMEN_MODELS_DIR=/path/to/Lumen/models
# MIMIC_IV_DIR=/path/to/mimiciv
# MIMIC_IV_NOTE_DIR=/path/to/mimic-iv-note
# LUMEN_GUIDELINES_DIR=/path/to/guidelines

# --- Retrieval (tuned defaults; see artifacts/benchmarks/retrieval-v1/) -----
# Pre-tuning baseline: 1.0 / 1.2 / 1.
LUMEN_RRF_BM25_WEIGHT=1.5
LUMEN_RRF_VECTOR_WEIGHT=0.75
LUMEN_QUERY_EXPANSION=0
LUMEN_HNSW_EF_SEARCH=1000

# --- Data plane ------------------------------------------------------------
# research = real MIMIC cohort, stdio/localhost only; demo = synthetic, shippable.
LUMEN_DATA_PLANE=research
# Defensive recovery only. Normal setup runs `python -m src.storage.checkpoints`
# explicitly, and graph construction is read-only with respect to schema.
LUMEN_CHECKPOINT_AUTO_SETUP=0
# Research model endpoints must be local. This override is intentionally
# conspicuous and should only be used in a controlled DUA-compliant network.
# LUMEN_RESEARCH_ALLOW_REMOTE_MODELS=0
# demo plane -> separate database on the same server (never the research DB)
# LUMEN_DEMO_DB_NAME=lumen_demo
# LUMEN_DEMO_DATABASE_URL=postgresql://postgres:change-me@localhost:5434/lumen_demo

# --- API and logs ----------------------------------------------------------
# The research facade always binds loopback; these primarily configure demo
# Compose/RunPod and local logging.
LUMEN_API_BIND=127.0.0.1
# LUMEN_API_PORT=8000
# LUMEN_LOG_LEVEL=INFO

# --- Tracing (Langfuse; OFF by default) ------------------------------------
# research plane: local Langfuse only (localhost / 127.0.0.1 / host.docker.internal)
# demo plane:     local, or a remote https endpoint (synthetic data only)
# LANGFUSE_BASE_URL is what the SDK uses (LANGFUSE_HOST is its deprecated alias);
# if neither is set the SDK targets https://cloud.langfuse.com.
# On the RunPod demo Pod these are not read from a file in the repo: pass
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY / LANGFUSE_BASE_URL on the
# scripts/bootstrap_pod.sh command line and it writes them into lumen.env (0600).
LUMEN_TRACING=0
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
